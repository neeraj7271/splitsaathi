# Copy to scripts/release.env and adjust values.
# scripts/release.env is gitignored.
#
# For GitHub Actions releases, configure repository secrets instead (see .github/workflows/release-mobile.yml).

GCP_PROJECT=splitsaathi-api
GCP_ZONE=asia-south1-c
GCP_INSTANCE=spitsaathi-backend-instance
GCP_USER=appadmin

API_URL=https://api.thesplitsaathi.com
APK_REMOTE_DIR=/var/www/downloads
APK_REMOTE_FILENAME=SplitSaathi.apk

# Admin auth for POST /v1/app/broadcast-update (required unless --skip-broadcast)
# Option A: paste a valid admin JWT
# ADMIN_JWT=

# Option B: login credentials (used when ADMIN_JWT is empty)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: purge Cloudflare cache after upload
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=

# Android release signing (preferred: apps/mobile/android/keystore.properties from
#   node scripts/generate-release-keystore.js
# ). Optional env override:
# SPLITSAATHI_UPLOAD_STORE_FILE=
# SPLITSAATHI_UPLOAD_STORE_PASSWORD=
# SPLITSAATHI_UPLOAD_KEY_ALIAS=
# SPLITSAATHI_UPLOAD_KEY_PASSWORD=

# --- GitHub Actions secrets (Settings → Secrets and variables → Actions) ---
# PR build workflow (build-mobile-pr.yml) needs only:
#   MOBILE_GOOGLE_SERVICES_JSON  (or MOBILE_GOOGLE_SERVICES_JSON_B64)
#
# Full release workflow (release-mobile.yml) also needs:
# Required:
#   GCP_SA_KEY                     Service account JSON with SSH/SCP to the GCP VM
#   MOBILE_GOOGLE_SERVICES_JSON    Full Firebase google-services.json file contents
#   ADMIN_EMAIL + ADMIN_PASSWORD   Or ADMIN_JWT instead
# Optional:
#   CLOUDFLARE_ZONE_ID, CLOUDFLARE_API_TOKEN
#   MOBILE_GOOGLE_SERVICES_JSON_B64  Base64 alternative if raw JSON is awkward to paste
